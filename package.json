{
  "name": "makitii-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --no-warnings server/src/index.js",
    "dev:web": "vite",
    "seed": "node --no-warnings server/src/seed.js",
    "seed:reset": "node --no-warnings server/src/seed.js --reset",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^10.0.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.9"
  }
}
